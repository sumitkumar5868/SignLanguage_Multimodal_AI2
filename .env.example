# Azure Cognitive Services Speech Configuration (Optional for Neural Odia & Indian Voices)
# AZURE_SPEECH_KEY=your_azure_speech_key_here
# AZURE_SPEECH_REGION=centralindia

# Custom Regional TTS Endpoints (Optional for external Bhojpuri / Odia APIs)
# ODIA_TTS_ENDPOINT=https://your-tts-api.com/synthesize?lang=or&text={text}
# BHOJPURI_TTS_ENDPOINT=https://your-tts-api.com/synthesize?lang=bho&text={text}
